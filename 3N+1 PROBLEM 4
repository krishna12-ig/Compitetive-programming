import java.util.*;

public class Solution {
     static int cycleLength(long n) {
        int count = 1;

        while (n != 1) {
            if ((n & 1) == 0)
                n = n / 2;
            else
                n = 3 * n + 1;
            count++;
        }
        return count;
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int i = sc.nextInt();
        int j = sc.nextInt();
        int oi = i;
        int oj = j;
        if (i > j) {
            int temp = i;
            i = j;
            j = temp;
        }
        int max = 0;
        for (int k = i; k <= j; k++) {
            int len = cycleLength(k);
            if (len > max)
                max = len;
        }
        System.out.println(oi + " " + oj + " " + max);
    }
}
