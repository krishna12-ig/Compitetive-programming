v, e = map(int, input().split())
graph = [[0] * v for _ in range(v)]
for _ in range(e):
    u, w, capacity = map(int, input().split())
    graph[u][w] += capacity
max_flow = 0
while True:
    visited = [False] * v
    parent = [-1] * v
    stack = [0]
    visited[0] = True
    while stack:
        u = stack.pop()
        for w in range(v):
            if not visited[w] and graph[u][w] > 0:
                visited[w] = True
                parent[w] = u
                stack.append(w)
                if w == v - 1:
                    break
        if visited[v - 1]:
            break
    if not visited[v - 1]:
        break
    flow = float('inf')
    x = v - 1
    while x != 0:
        p = parent[x]
        flow = min(flow, graph[p][x])
        x = p
    x = v - 1
    while x != 0:
        p = parent[x]
        graph[p][x] -= flow
        graph[x][p] += flow
        x = p
    max_flow += flow
print(max_flow)



