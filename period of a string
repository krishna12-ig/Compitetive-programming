import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.next();
        
        int n = s.length();
        int[] lps = new int[n];
        
        int i = 1;
        int j = 0;
        
        while (i < n) {
            if (s.charAt(i) == s.charAt(j)) {
                lps[i] = j + 1;
                i++;
                j++;
            } else {
                if (j > 0) {
                    j = lps[j - 1];
                } else {
                    i++;
                }
            }
        }
        int p = n - lps[n - 1];
        
        if (n % p == 0)
            System.out.println(p);
        else
            System.out.println(n);
    }
}
