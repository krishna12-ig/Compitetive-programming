import java.io.*;
import java.util.*;

public class Solution {

    static class Cell {
        int row;
        int col;

        Cell(int row, int col) {
            this.row = row;
            this.col = col;
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int m = sc.nextInt();

        int[][] grid = new int[n][m];

        Queue<Cell> queue = new LinkedList<>();

        int fresh = 0;

      
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {

                grid[i][j] = sc.nextInt();

                if (grid[i][j] == 2) {
                    
                    queue.add(new Cell(i, j));
                }
                else if (grid[i][j] == 1) {
                    fresh++;
                }
            }
        }

        if (fresh == 0) {
            System.out.println(0);
            return;
        }

        int time = 0;

        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};

        // BFS
        while (!queue.isEmpty()) {

            int size = queue.size();
            boolean rottenThisMinute = false;

            for (int i = 0; i < size; i++) {

                Cell current = queue.poll();

                int r = current.row;
                int c = current.col;

                for (int d = 0; d < 4; d++) {

                    int nr = r + dr[d];
                    int nc = c + dc[d];

                    if (nr >= 0 && nr < n &&
                        nc >= 0 && nc < m &&
                        grid[nr][nc] == 1) {

                        grid[nr][nc] = 2;

                        fresh--;

                        queue.add(new Cell(nr, nc));

                        rottenThisMinute = true;
                    }
                }
            }

            if (rottenThisMinute) {
                time++;
            }
        }

        if (fresh > 0) {
            System.out.println(-1);
        }
        else {
            System.out.println(time);
        }

        sc.close();
    }
}
