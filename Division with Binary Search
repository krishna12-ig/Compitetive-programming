import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int dividend = sc.nextInt();
        int divisor = sc.nextInt();

        int low = 0;
        int high = dividend;
        int ans = 0;

        while (low <= high) {
            int mid = (low + high) / 2;

            if (mid * divisor <= dividend) {
                ans = mid;
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }

        System.out.println(ans);
    }
}
