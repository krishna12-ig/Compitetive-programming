import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int m = sc.nextInt();

        int[][] a = new int[n][m];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                a[i][j] = sc.nextInt();
            }
        }

        int t = 0;
        int b = n - 1;
        int l = 0;
        int r = m - 1;

       while (t <= b && l <= r) {

        
            for (int j = l; j <= r; j++) {
                System.out.print(a[t][j] + " ");
            }
            t++;

           
            for (int i = t; i <= b; i++) {
                System.out.print(a[i][r] + " ");
            }
            r--;

            
            if (t <= b) {
                for (int j = r; j >= l; j--) {
                    System.out.print(a[b][j] + " ");
                }
                b--;
            }

           
            if (l <= r) {
                for (int i = b; i >= t; i--) {
                    System.out.print(a[i][l] + " ");
                }
                l++;
            }
        }
    }
}
